<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fill (keep the light yellow) -->
    <solid android:color="#FFF9C4"/>

    <!-- BORDER -->
    <stroke
        android:width="1dp"
        android:color="@android:color/darker_gray"/>


    <!-- Inner spacing so text doesn't hug the border -->
    <padding
        android:left="6dp"
        android:top="4dp"
        android:right="6dp"
        android:bottom="4dp"/>
</shape>


